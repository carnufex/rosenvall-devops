{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Authority": "",
    "Audience": "rosenvall-devops"
  },
  "Frontend": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://devops.rosenvall.se"
    ]
  },
  "ConnectionStrings": {
    "DevOps": ""
