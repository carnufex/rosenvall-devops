      "RepositoryImplementation": {
        "Enabled": true,
        "MaxStartedPerActor": 4,
        "WindowSeconds": 900
      },
      "PullRequestReviewFix": {
        "Enabled": true,
        "MaxStartedPerActor": 4,
        "WindowSeconds": 900
      }
    }
