    "OllamaEndpoint": "http://localhost:11434/api",
    "Codex": {
      "Path": "codex",
      "Home": "",
      "Model": "gpt-5.5",
      "ReasoningEffort": "high",
      "AvailableModels": [
        "gpt-5.5",
        "gpt-5.4",
        "gpt-5.4-mini",
        "gpt-5.3-codex",
        "gpt-5.3-codex-spark",
        "gpt-5.2",
        "codex-auto-review"
      ],
      "RequestTimeoutSeconds": 120,
      "PreviewSourceJobTimeoutSeconds": 600,
      "ImplementationTimeoutSeconds": 300
    },
    "RequestTimeoutSeconds": 120
  },
  "Actions": {
    "Quotas": {
      "AiPlanning": {
        "Enabled": true,
        "MaxStartedPerActor": 12,
        "WindowSeconds": 600
